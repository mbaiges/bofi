{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch via NPM",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script",
                "debug"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "program": "${file}",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Backend (api/server.js)",
            "program": "${workspaceFolder}/api/server.js",
            "cwd": "${workspaceFolder}/api",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Debug Frontend (React in Chrome)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}